# Skopiuj do .env.local i uzupełnij wartości.

# --- Clerk (logowanie) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/auth
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/auth
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# --- Supabase (baza danych) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI Coach i import biegów ze zrzutu ekranu ---
ANTHROPIC_API_KEY=

# --- Weryfikacja dwuetapowa (dowolny długi losowy ciąg) ---
MFA_SECRET=

# --- Wysyłka e-maili (kody 2FA) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Tylko lokalnie: pominięcie logowania (w produkcji ignorowane) ---
NEXT_PUBLIC_BYPASS_AUTH=false
DEV_BYPASS_USER_ID=
