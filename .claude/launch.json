{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "dev-bypass",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set NEXT_PUBLIC_BYPASS_AUTH=true&& set NEXT_DIST_DIR=.next-preview&& npx next dev -p 3002"
      ],
      "port": 3002
    },
    {
      "name": "prosta-apka",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5500",
        "-d",
        "prosta-apka"
      ],
      "port": 5500
    }
  ]
}